#!/usr/bin/env bash
#
# Installs "DMX Control.app", a double-clickable macOS launcher for bin/full_start.
#
#   bin/install               -> ~/Applications/DMX Control.app
#   bin/install /Applications -> /Applications/DMX Control.app
#
# Re-run it after moving the repo (the launcher stores an absolute path).
# Replacing a bundle while an instance is running is safe: the old file is
# unlinked, not overwritten, so the running launcher keeps reading it.

set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DEST_DIR="${1:-$HOME/Applications}"
APP="$DEST_DIR/DMX Control.app"

mkdir -p "$DEST_DIR"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"

# --- Icon: built from the client favicon so the two never drift apart ---------

ICON_SRC="$ROOT/dmx-control-client/public/dmx-favicon.png"
ICON_NAME=""

if [ -f "$ICON_SRC" ] && command -v iconutil >/dev/null 2>&1; then
  ICONSET=$(mktemp -d)/dmx-control.iconset
  mkdir -p "$ICONSET"
  # size:name pairs -- macOS wants both @1x and @2x of each logical size.
  for spec in \
    16:icon_16x16      32:icon_16x16@2x \
    32:icon_32x32      64:icon_32x32@2x \
    128:icon_128x128   256:icon_128x128@2x \
    256:icon_256x256   512:icon_256x256@2x \
    512:icon_512x512   1024:icon_512x512@2x
  do
    px="${spec%%:*}"
    name="${spec##*:}"
    sips -z "$px" "$px" "$ICON_SRC" --out "$ICONSET/$name.png" >/dev/null 2>&1
  done
  if iconutil -c icns "$ICONSET" -o "$APP/Contents/Resources/dmx-control.icns" 2>/dev/null; then
    ICON_NAME="dmx-control"
  fi
  rm -rf "$(dirname "$ICONSET")"
fi

ICON_KEY=""
[ -n "$ICON_NAME" ] && ICON_KEY="  <key>CFBundleIconFile</key>        <string>$ICON_NAME</string>"

cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>            <string>DMX Control</string>
  <key>CFBundleDisplayName</key>     <string>DMX Control</string>
  <key>CFBundleIdentifier</key>      <string>com.maadavenue.dmx-control</string>
  <key>CFBundleVersion</key>         <string>1.0</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundlePackageType</key>     <string>APPL</string>
  <key>CFBundleExecutable</key>      <string>dmx-control</string>
$ICON_KEY
  <key>NSHighResolutionCapable</key> <true/>
</dict>
</plist>
PLIST

cat > "$APP/Contents/MacOS/dmx-control" <<LAUNCHER
#!/bin/bash
# Generated by bin/install -- do not edit, re-run bin/install instead.
LOG="\$HOME/Library/Logs/dmx-control.log"
mkdir -p "\$(dirname "\$LOG")"
echo "=== \$(date) ===" >>"\$LOG"

# A login shell is required so nvm / homebrew are on PATH when launched from Finder.
/bin/zsh -lc '"$ROOT/bin/full_start"' >>"\$LOG" 2>&1
STATUS=\$?

if [ \$STATUS -ne 0 ]; then
  # Nothing is visible when launched from Finder, so report failures in a dialog.
  DETAIL=\$(grep 'ERROR' "\$LOG" | tail -3)
  [ -z "\$DETAIL" ] && DETAIL=\$(tail -5 "\$LOG")
  /usr/bin/osascript - "\$DETAIL" "\$LOG" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  display dialog "DMX Control failed to start." & return & return & (item 1 of argv) & return & return & "Full log: " & (item 2 of argv) buttons {"OK"} with icon stop with title "DMX Control"
end run
APPLESCRIPT
fi

exit \$STATUS
LAUNCHER

chmod +x "$APP/Contents/MacOS/dmx-control"
touch "$APP"

# Reinstalling over an existing bundle otherwise leaves Finder and the Dock
# showing the previous cached icon.
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
[ -x "$LSREGISTER" ] && "$LSREGISTER" -f "$APP" >/dev/null 2>&1 || true

echo "Installed: $APP"
echo "Logs:      ~/Library/Logs/dmx-control.log"
